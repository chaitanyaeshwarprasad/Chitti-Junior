# Copy this file to ".env" (same folder) or paste your keys in the dashboard (setup wizard), which does it for you.
# .env is ignored by git: your keys never get uploaded.

# Required: Chitti's brain. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: natural Telugu voice + hearing. Get one at https://dashboard.sarvam.ai
# Without it Chitti uses a free Microsoft voice and hears with Whisper on your PC.
SARVAM_API_KEY=
